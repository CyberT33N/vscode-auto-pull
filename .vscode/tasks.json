{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch:typecheck",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "watch:typecheck"
      ],
      "isBackground": true,
      "problemMatcher": "$tsc-watch",
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "watch:bundle",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "run",
        "watch:bundle"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): ERROR: (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "severity": "error"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch:bundle\\] build started$",
          "endsPattern": "^\\[watch:bundle\\] build finished$"
        }
      },
      "presentation": {
        "reveal": "never"
      }
    },
    {
      "label": "watch",
      "dependsOn": [
        "watch:typecheck",
        "watch:bundle"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
